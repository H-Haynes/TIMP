{
  "name": "timp-music",
  "version": "3.0.0",
  "description": "TIMP音乐播放器",
  "author": "H-Haynes",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main/index.js",
  "keywords": [
    "electron",
    "rollup",
    "vite",
    "vue3",
    "vue",
    "酷我",
    "QQ音乐",
    "酷狗",
    "网易云音乐",
    "咪咕音乐",
    "TIMP音乐"
  ],
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:3344/"
    }
  },
  "scripts": {
    "app:dev": "vite",
    "app:build": "vite build && electron-builder",
    "app:preview": "vite preview",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "vitest run",
    "test:watch": "vitest",
    "commit": "git-cz",
    "prepare": "husky",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "version": "conventional-changelog -p angular -i CHANGELOG.md -s && git add CHANGELOG.md",
    "deps:update": "taze major -I",
    "compile": "npm run app:build && electron-builder build --config .electron-builder.config.js --dir --config.asar=false",
    "dist": "npm run app:build & electron-builder"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vueuse/core": "^14.3.0",
    "autoprefixer": "^10.4.16",
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "git-cz": "^4.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persist": "^1.0.0",
    "postcss": "^8.4.32",
    "sass": "^1.69.7",
    "tailwindcss": "^4.3.0",
    "taze": "^19.14.1",
    "tree-kill": "^1.2.2",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-element-plus": "^0.11.2",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^0.15.5",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.8",
    "vue": "^3.4.4",
    "vue-i18n": "^11.4.4",
    "vue-router": "^5.1.0",
    "vue-tsc": "^3.3.3"
  },
  "dependencies": {
    "@vue/devtools": "^8.1.2",
    "axios": "^1.6.5",
    "dayjs": "^1.11.10",
    "electron-devtools-installer": "^4.0.0",
    "element-plus": "^2.4.4",
    "form-data": "^4.0.0",
    "lodash-es": "^4.17.21",
    "mitt": "^3.0.1",
    "normalize.css": "^8.0.1",
    "pinia-auto-refs": "^0.0.12",
    "qs": "^6.11.2",
    "throttle-debounce": "^5.0.0",
    "unocss": "^66.7.0",
    "unplugin-vue-components": "^32.1.0"
  },
  "lint-staged": {
    "*.{ts,vue,js,jsx}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{scss,css,json,md}": [
      "oxfmt --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  }
}
