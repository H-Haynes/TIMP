{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "warn", // 代码正确性问题（如语法错误、可能的运行时错误）
    "suspicious": "warn", // 可疑代码（如未使用的变量、未定义的函数）
    "pedantic": "off", // 过于严格的代码（如强制使用特定的代码风格）
    "perf": "off", // 性能问题（如未优化的代码、未使用最佳实践）
    "style": "off", // 代码风格问题（如未使用最佳实践、未遵循代码规范）
    "restriction": "off", // 限制性问题（如未使用特定的代码风格、未遵循代码规范）
    "nursery": "off" // 实验性代码（如未经过充分测试的代码、未经过充分验证的代码）
  },
  "plugins": ["typescript", "vue", "unicorn", "import", "jsdoc"],
  "rules": {
    "typescript/no-explicit-any": ["warn", { "ignoreRestArgs": true }], // 禁止使用any类型,但忽略剩余参数
    "typescript/ban-ts-comment": "off", // 允许使用ts-comment注释
    "typescript/no-non-null-assertion": "off", // 允许使用非空断言
    "typescript/no-var-requires": "off", // 允许使用require语法
    "typescript/explicit-module-boundary-types": "off", // 关闭导出函数的显式返回类型要求
    "typescript/explicit-function-return-type": "off", // 关闭函数的显式返回类型要求
    "typescript/ban-types": "off", // 不禁止使用特定类型
    // "typescript/no-unsafe-member-access": "error", // 禁止访问 any/unknown 类型的成员属性
    // "typescript/no-unsafe-assignment": "warn", // 禁止 any/unknown 类型值的赋值
    // "typescript/no-unsafe-call": "error", // 禁止调用 any/unknown 类型的值
    // "typescript/no-unsafe-return": "warn", // 禁止返回 any/unknown 类型的值

    "no-console": "warn", // 警告 console 使用"
    "no-eval": "off", // 允许 eval（通常不建议但某些场景需要）
    "eqeqeq": "off", // 不强制使用 === / !==
    "curly": "warn", // 要求使用大括号包裹代码块
    "no-use-before-define": "off", // 允许在定义前使用
    "no-unreachable": "warn", // 禁止不可达代码
    "no-array-sort": "off",
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_", // 忽略 _ 开头的函数参数
        "varsIgnorePattern": "^_" // 忽略 _ 开头的普通变量 ✅
      }
    ], // 禁止未使用的变量
    "no-debugger": "error", // 禁止使用debugger
    "no-func-assign": "warn", // 禁止对函数声明赋值
    "default-case": "warn", // 要求 switch 语句有 default 分支
    "no-empty-function": "warn", // 禁止空函数
    "no-lone-blocks": "warn", // 禁止孤立代码块
    "no-redeclare": "warn", // 禁止重复声明变量
    "no-return-assign": "warn", // 禁止在返回语句中赋值
    "no-self-assign": "warn", // 禁止自我赋值
    "no-self-compare": "warn", // 禁止与自身比较
    "no-useless-return": "warn", // 禁止无意义的 return
    "no-useless-catch": "warn", // 禁止无用的 catch 块
    "no-shadow": "off", // 允许变量遮蔽，指在内层作用域中声明的变量与外层作用域中已存在的变量同名，导致内层变量"遮蔽"了外层变量的现象
    "no-delete-var": "off", // 允许 delete 删除变量
    "max-depth": "warn", // 警告嵌套层级过深（默认 4 层）
    "max-lines": ["warn", { "max": 2500 }], // 警告超过 2500 行的文件
    "max-statements": ["warn", 150], // 单函数最大语句数
    "max-nested-callbacks": ["warn", 4], // 警告回调嵌套超过 4 层
    "max-params": ["warn", 5], // 函数最大参数数量

    "no-lonely-if": "warn", // 禁止独立的 if 语句（应使用 else）
    "prefer-const": "warn", // 优先使用 const

    "prefer-rest-params": "warn", // 优先使用剩余参数
    "no-useless-escape": "warn", // 禁止无用的转义字符
    "no-irregular-whitespace": "warn", // 禁止不规则空白符
    "no-prototype-builtins": "warn", // 禁止直接调用 Object.prototype 方法
    "no-fallthrough": "off", // 禁止 switch case 穿透,即要求 switch case 有 break
    "no-extra-boolean-cast": "warn", // 禁止多余的布尔转换
    "no-case-declarations": "warn", //要求 case 内声明变量使用 {}
    "no-async-promise-executor": "warn", // 禁止在 Promise executor 中使用 async

    "eslint/no-else-return": "warn", // 禁止 if-else 中不必要的 return
    "eslint/eqeqeq": "off", // 关闭严格相等检查
    "no-dupe-keys": "warn", // 条件编译可能会重复

    "no-underscore-dangle": "off", // 可以使用下划线开头的变量
    "import/no-unassigned-import": "off", // 允许未导入的模块

    // JSDoc — 文档注释规范
    // "jsdoc/check-access": "warn", // 要求 @access 标签有效
    // "jsdoc/check-property-names": "warn", // 要求 @property 名称与实际属性匹配
    // "jsdoc/check-tag-names": "warn", // 要求 JSDoc 标签名称有效
    // "jsdoc/empty-tags": "warn", // 禁止空的 JSDoc 标签
    // "jsdoc/implements-on-classes": "warn", // 要求 @implements 仅在类上使用
    // "jsdoc/no-defaults": "warn", // 禁止 @default 与默认值重复
    // "jsdoc/require-property": "warn", // 要求 @property 描述属性
    // "jsdoc/require-property-description": "warn", // 要求 @property 有描述
    // "jsdoc/require-property-name": "warn", // 要求 @property 有名称
    // "jsdoc/require-property-type": "warn", // 要求 @property 有类型
    // "jsdoc/require-returns": "warn", // 要求有返回值的函数写 @returns
    // "jsdoc/require-yields": "warn", // 要求生成器函数写 @yields
    // "jsdoc/require-param": "error",
    // "jsdoc/require-param-description": "error",
    // "jsdoc/require-returns-description": "warn",

    "vue/no-import-compiler-macros": "off" // 允许使用 import 导入编译器宏（如 defineProps）
  },
  "globals": {
    "uni": "readonly",
    "getApp": "readonly",
    "getCurrentPages": "readonly"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2021": true
  },
  "ignorePatterns": ["node_modules/", "dist/", "unpackage/", ".pnpm-store/", "*.config.*"]
}
